# ────────────────────────────────────────────
#  MHAO APP – Variables d'environnement
#  Copier en .env et remplir les valeurs
# ────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Database
POSTGRES_USER=mhao
POSTGRES_PASSWORD=mhao_secret_change_in_prod
POSTGRES_DB=mhao_db
DATABASE_URL=postgresql://mhao:mhao_secret_change_in_prod@localhost:5432/mhao_db

# Redis (transport microservices + cache + JWT blacklist)
REDIS_PASSWORD=redis_secret_change_in_prod
REDIS_URL=redis://:redis_secret_change_in_prod@localhost:6379

# JWT – Utiliser openssl pour générer les clés RS256 en production
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# MinIO / Stockage fichiers
MINIO_ROOT_USER=mhao_minio
MINIO_ROOT_PASSWORD=minio_secret_change_in_prod
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=mhao-files
MINIO_USE_SSL=false

# Mobile Money – MTN MoMo
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=https://api.habitat-marketplace.com/payments/mobile-money/callback

# Mobile Money – Orange Money
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

# SMS OTP – Africa's Talking
SMS_PROVIDER=africastalking
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=MHAO

# Email – SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@habitat-marketplace.com
SENDGRID_FROM_NAME=Marketplace Habitat

# Firebase FCM – Notifications push
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Chiffrement données sensibles (AES-256)
ENCRYPTION_KEY=change_this_32_char_key_in_prod!!

# Sentry – Monitoring erreurs
SENTRY_DSN=
